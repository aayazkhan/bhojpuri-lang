// Bazaar ke hisaab: list, index, "har ... me" loop aur built-in kaam (lambai, daal, nikaal)
ka ho bhaiya
  maan la saaman = ["aalu", "pyaaz", "sattu"];
  maan la daam = [30, 40, 120];

  daal(saaman, "litti");
  daal(daam, 50);

  kaam kul_jor(list) {
    maan la kul = 0;
    har paisa list me {
      kul += paisa;
    }
    lauta da kul;
  }

  har i = 0 se lambai(saaman) - 1 tak {
    bol ho saaman[i], "—", daam[i], "rupiya";
  }
  bol ho "Kul hisaab:", kul_jor(daam), "rupiya";

  maan la hataawal = nikaal(saaman);
  bol ho hataawal, "hata dihal gail. Bachal:", saaman;
chalat bani bhaiya
