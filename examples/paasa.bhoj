// Paasa ke khel: standard library ke kaam (sankhya, shabd, gol, neeche, sanyog, bada, tod, jod)
ka ho bhaiya
  maan la khiladi = tod("ramu,shyamu,gita", ",");
  maan la ank = [];

  // Har khiladi teen baar paasa phenkela.
  maan la i = 0;
  jab le (i < lambai(khiladi)) {
    maan la kul = 0, phenk = [], j = 0;
    jab le (j < 3) {
      maan la paasa = sanyog(1, 6);
      daal(phenk, paasa);
      kul += paasa;
      j += 1;
    }
    daal(ank, kul);
    bol ho bada(khiladi[i]) + ":", jod(phenk, " + "), "=", kul;
    i += 1;
  }

  // Sab se bada ank kekar ba?
  maan la jeeta = 0;
  i = 1;
  jab le (i < lambai(ank)) {
    jadi (ank[i] > ank[jeeta]) { jeeta = i; }
    i += 1;
  }
  bol ho "Jeetal:", khiladi[jeeta];

  maan la jor = 0;
  i = 0;
  jab le (i < lambai(ank)) { jor += ank[i]; i += 1; }
  bol ho "Ausat ank:", gol(jor / lambai(ank) * 10) / 10;
  bol ho "Aadha jor:", neeche(jor / 2), "(" + kism(jor) + ")";

  // Text se sankhya aur sankhya se text.
  maan la likhal = "12";
  bol ho likhal + " + 1 =", sankhya(likhal) + 1, "aur", shabd(sankhya(likhal) + 1) + "!";
chalat bani bhaiya
