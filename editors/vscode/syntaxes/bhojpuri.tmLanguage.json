{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bhojpuri Lang",
  "scopeName": "source.bhojpuri",
  "comment": "Generated by scripts/build-vscode-grammar.js from src/keywords.js. Don't edit by hand.",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#loop-header"
        },
        {
          "include": "#function-definition"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#braces"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bhojpuri",
          "match": "//.*$"
        },
        {
          "name": "comment.block.bhojpuri",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bhojpuri",
          "begin": "\"",
          "end": "\"|$",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.bhojpuri",
          "begin": "'",
          "end": "'|$",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.template.bhojpuri",
          "begin": "`",
          "end": "`|$",
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "name": "meta.embedded.expression.bhojpuri",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.bhojpuri"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.bhojpuri"
                }
              },
              "contentName": "source.bhojpuri",
              "patterns": [
                {
                  "include": "#code"
                }
              ]
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.bhojpuri",
      "match": "\\\\."
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#code"
        }
      ]
    },
    "loop-header": {
      "begin": "(?<![\\p{L}\\p{M}\\p{N}_])(har)(?![\\p{L}\\p{M}\\p{N}_])",
      "end": "(?=\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.loop.bhojpuri"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "name": "keyword.control.loop.bhojpuri",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:kadam|tak|se|me)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#builtins"
        }
      ]
    },
    "function-definition": {
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(kaam)[ \\t]+([\\p{L}_][\\p{L}\\p{M}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.bhojpuri"
        },
        "2": {
          "name": "entity.name.function.bhojpuri"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.bhojpuri",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:koshish[ \\t]+kara|na[ \\t]+ta[ \\t]+jadi|aage[ \\t]+badha|bas[ \\t]+kara|lauta[ \\t]+da|galti[ \\t]+pe|phenk[ \\t]+da|jab[ \\t]+le|na[ \\t]+ta|jadi)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.other.program.bhojpuri",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:chalat[ \\t]+bani[ \\t]+bhaiya|ka[ \\t]+ho[ \\t]+bhaiya)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "storage.type.bhojpuri",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:maan[ \\t]+la|kaam)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "keyword.other.print.bhojpuri",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:bol[ \\t]+ho)(?![\\p{L}\\p{M}\\p{N}_])"
        },
        {
          "name": "constant.language.bhojpuri",
          "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:jhooth|khaali|sach)(?![\\p{L}\\p{M}\\p{N}_])"
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.bhojpuri",
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])\\d+(?:\\.\\d+)?"
    },
    "builtins": {
      "name": "support.function.builtin.bhojpuri",
      "match": "(?<![\\p{L}\\p{M}\\p{N}_])(?:sankhya|chhaant|lambai|nikaal|neeche|sanyog|chhota|chaabi|poochh|chhaan|shabd|hataw|hissa|badal|daal|kism|bada|ulta|khoj|gol|tod|jod|kul|ba)(?=\\s*\\()"
    }
  }
}
